* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, sans-serif;
}

/* HEADER */
header {
    background-color: #4b2e2e;
    color: rgb(255, 255, 255);
    text-align: center;
    padding: 30px;
}

/* MAIN */
main {
    display: flex;
    justify-content: space-around;
    align-items: center;
    padding: 50px;
    background-color: #312922;
}

/* TEXT */
.text {
    width: 40%;
}

.text h2 {
    font-size: 32px;
    margin-bottom: 15px;
}

.text p {
    font-size: 18px;
    margin-bottom: 20px;
}

button {
    padding: 10px 20px;
    background-color: #6f4e37;
    color: white;
    border: none;
    cursor: pointer;
}

button:hover {
    background-color: #4b2e2e;
}

/* IMAGE */
.image img {
    width: 300px;
    border-radius: 10px;
}

/* FOOTER */
footer {
    background-color: #513636;
    text-align: center;
    padding: 15px;
    margin-top: 30px;
}
